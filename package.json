{
  "name": "nextjs-mtcaptcha",
  "version": "1.0.0",
  "description": "Official Next.js plugin for MTCaptcha. Renders the widget in the App Router and the Pages Router, and verifies tokens on the server.",
  "author": "MTCaptcha Public",
  "license": "MIT",
  "homepage": "https://github.com/mtcaptcha-public/nextjs-mtcaptcha#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtcaptcha-public/nextjs-mtcaptcha.git"
  },
  "bugs": {
    "url": "https://github.com/mtcaptcha-public/nextjs-mtcaptcha/issues"
  },
  "keywords": [
    "nextjs",
    "nextjs-plugin",
    "mtcaptcha",
    "captcha",
    "react",
    "app-router",
    "pages-router",
    "security"
  ],
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./server": {
      "types": "./lib/server.d.ts",
      "import": "./lib/server.js",
      "require": "./lib/server.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "lib/server.d.ts"
      ]
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf lib && tsup",
    "test": "node --experimental-strip-types --test test/**/*.test.ts",
    "prepublishOnly": "npm test && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "next": "^14.2.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
